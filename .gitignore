__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
.claude/settings.local.json

# the dataset (`poreml download`): terabytes, never in git
data/

# generated by the tests and the smoke recipe
runs/
tests/_data/
tests/test_output/
demo/runs/

# research copies of the upstream model repositories; never imported
repos/

# case outputs stay on disk, never in git: every campaign folder, log and manifest under
# case/<study>/ is generated (checkpoints, frames, per-frame CSVs, reports). Only the drivers,
# SLURM workers and READMEs directly under case/<study>/ are source.
case/*/*/
case/.cache/
util/*/_logs/
util/*/_manifests/
*.log
*.pid

# the development archive keeps its scripts and notes, not its checkpoints and renders
util/archive/train_archive/
util/archive/scripts/shift_ssh_state/
util/archive/cases/*/ckpts/
util/archive/cases/*/output/
util/archive/cases/*/archive/
util/archive/**/*.png
util/archive/**/*.gif

# the anonymity sweep's patterns are themselves identifying
util/release/deny.txt
